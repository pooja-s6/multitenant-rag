# Copy to .env for local uvicorn / Vite.
# Docker Compose overrides DATABASE_URL and REDIS_URL with service hostnames.

APP_NAME=Multi-Tenant RAG
ENVIRONMENT=development

# Local processes. Inside Compose these are postgres and redis.
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag
REDIS_URL=redis://localhost:6379/0

# Replace this in any shared or production environment.
JWT_SECRET=dev-only-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# openai uses LLM_API_KEY. An empty key keeps the fake provider.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
SMALL_MODEL=gpt-4o-mini
LARGE_MODEL=gpt-4o

CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_TTL=3600

RETRIEVAL_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.30
ROUTING_COMPLEXITY_THRESHOLD=0.45

# USD per 1,000,000 tokens.
SMALL_MODEL_PRICE=0.15
LARGE_MODEL_PRICE=2.50
SMALL_MODEL_OUTPUT_PRICE=0.60
LARGE_MODEL_OUTPUT_PRICE=10.00

CORS_ORIGINS=http://localhost:5173,http://localhost:8080
